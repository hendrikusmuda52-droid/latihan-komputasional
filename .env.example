# SAKOLA Environment Variables Template
# Copy this file to .env or .env.local and fill in real values.
# NEVER commit .env or .env.local to Git — they are gitignored.

# ──────────────────────────────────────────────────────────────────
# Database (Supabase PostgreSQL — REQUIRED, never use SQLite)
# ──────────────────────────────────────────────────────────────────
# ⚠️ PENTING: Supabase punya DUA mode koneksi dengan pool size berbeda:
#
#   Port 6543 = Transaction mode (PgBouncer) → pool size 200 (FREE tier)
#                Dipakai untuk DATABASE_URL (runtime query Prisma).
#                Aman untuk Vercel serverless (banyak concurrent request).
#
#   Port 5432 = Session mode (direct) → pool size 15 (FREE tier)
#                Dipakai untuk DIRECT_URL (migration Prisma saja).
#                JANGAN dipakai untuk runtime — akan cepat habis pool-nya
#                dan muncul error "EMAXCONNSESSION max clients reached".
#
# Cara dapat URL:
#   1. Login ke https://supabase.com
#   2. Pilih project → Settings → Database → Connection string
#   3. Pilih tab "Transaction" (untuk port 6543) dan "Session" (untuk 5432)
# ──────────────────────────────────────────────────────────────────

# DATABASE_URL: pakai port 6543 (Transaction mode / PgBouncer)
# Tambahkan ?pgbouncer=true&connection_limit=1 untuk optimasi serverless
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: pakai port 5432 (Session mode) — HANYA untuk migration
DIRECT_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# AI (Gemini / z-ai-web-dev-sdk)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# JWT Secret (optional — falls back to GEMINI_API_KEY if not set)
# JWT_SECRET=your_custom_jwt_secret
