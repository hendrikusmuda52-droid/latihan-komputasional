// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id           String     @id @default(cuid())
  namaLengkap  String
  nisn         String     @unique
  kelas        String
  sekolah      String
  jenisKelamin String
  createdAt    DateTime   @default(now())

  results      Result[]
}

model Teacher {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // disimpan sebagai hash SHA-256
  name      String
  createdAt DateTime @default(now())
}

model Question {
  id            String   @id @default(cuid())
  gradeLevel    String   // '8' atau '9'
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer Int      // 0-3
  explanation   String
  category      String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TypingText {
  id           String   @id @default(cuid())
  gradeLevel   String   // '8A', '8B', '8C', '9A', '9B'
  title        String
  content      String
  isStructured Boolean  @default(false) // true untuk kelas 9 (format markdown)
  isActive     Boolean  @default(true)  // hanya 1 aktif per kelas yang dipakai
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Result {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Typing test metrics
  typedText       String   // teks yang berhasil diketik siswa
  charCount       Int      // jumlah karakter yang diketik
  correctChars    Int      // karakter yang benar (sesuai teks asli)
  typingSpeedWPM  Float    // kecepatan mengetik (kata per menit)
  typingAccuracy  Float    // akurasi (%)
  typingDuration  Int      // durasi aktual mengetik (detik)
  typingScore     Float    // nilai akhir typing (0-100)

  // Quiz metrics
  quizAnswers     String   // JSON array of {questionId, selectedAnswer}
  quizCorrect     Int      // jumlah jawaban benar
  quizTotal       Int      // total soal (30)
  quizScore       Float    // nilai akhir quiz (0-100)

  // Overall
  totalScore      Float    // kombinasi (0-100)
  completedAt     DateTime @default(now())
}
