// SAKOLA - Multi-Subject & Multi-Teacher Isolation Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id           String     @id @default(cuid())
  namaLengkap  String
  nisn         String     @unique
  password     String     @default("")
  kelas        String     // "7A", "8B", "9C", "11DKV", "12DKV"
  jenjang      String     @default("SMP") // "SMP" atau "SMK"
  sekolah      String
  jenisKelamin String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  results      Result[]
  progresses   Progress[]
  manualGrades ManualGrade[]
}

model Teacher {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  name        String
  role        String   @default("teacher") // "admin", "teacher", "bendahara"
  subject     String   @default("Informatika") // mata pelajaran utama
  kelasDiampu String   @default("7,8,9") // comma-separated: "7,8,9" atau "11DKV,12DKV"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Question {
  id            String   @id @default(cuid())
  gradeLevel    String   // "7", "8", "9", "11DKV", "12DKV"
  subject       String   @default("Informatika") // mata pelajaran
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer Int
  explanation   String
  category      String
  isActive      Boolean  @default(true)
  imageUrl      String?
  teacherId     String?  // guru yang membuat soal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TypingText {
  id           String   @id @default(cuid())
  gradeLevel   String
  subject      String   @default("Informatika")
  title        String
  content      String
  isStructured Boolean  @default(false)
  isActive     Boolean  @default(true)
  teacherId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Assignment {
  id            String    @id @default(cuid())
  title         String
  description   String    @default("")
  subject       String    @default("Informatika") // mata pelajaran
  targetKelas   String    @default("ALL")
  targetJenjang String    @default("ALL") // "SMP", "SMK", "ALL"
  isActive      Boolean   @default(true)
  dueDate       DateTime?
  exerciseType  String    @default("wajib")
  questionCount Int       @default(0)
  taskType      String    @default("typing_quiz")
  teacherId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Material {
  id          String   @id @default(cuid())
  title       String
  content     String
  subject     String   @default("Informatika")
  targetKelas String   @default("ALL")
  targetJenjang String @default("ALL")
  category    String   @default("Umum")
  isActive    Boolean  @default(true)
  teacherId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ManualGrade {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  score       Float
  description String   @default("")
  subject     String   @default("Informatika") // mapel yang dinilai
  isReleased  Boolean  @default(false)
  teacherId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([studentId])
}

model Progress {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentStage    String   @default("typing")
  typedText       String   @default("")
  charCount       Int      @default(0)
  correctChars    Int      @default(0)
  typingStartTime String   @default("")
  typingDuration  Int      @default(0)
  quizAnswers     String   @default("{}")
  quizStartTime   String   @default("")
  quizDuration    Int      @default(0)
  isCompleted     Boolean  @default(false)
  lastSavedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([studentId])
}

model Result {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  typedText       String
  charCount       Int
  correctChars    Int
  typingSpeedWPM  Float
  typingAccuracy  Float
  typingDuration  Int
  typingScore     Float
  quizAnswers     String
  quizCorrect     Int
  quizTotal       Int
  quizScore       Float
  totalScore      Float
  subject         String   @default("Informatika") // mapel dari tugas
  completedAt     DateTime @default(now())
  isReleased      Boolean  @default(false)
  releasedAt      DateTime?
}
