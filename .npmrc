# ============================================================
# NPM Configuration untuk Vercel build
# ============================================================
# FIX: npm v10+ punya security feature yang block install scripts
# secara default. Config ini approve scripts yang dibutuhkan.
# ============================================================

# Jangan block install scripts (Prisma, swc butuh postinstall)
ignore-scripts=false

# Paksa foreground scripts agar postinstall jalan di main thread
foreground-scripts=true

# Kompatibel dengan Vercel build environment
legacy-peer-deps=true

# Disable funding + audit untuk cepatkan build
fund=false
audit=false

# Cache config untuk Vercel
save-exact=false
